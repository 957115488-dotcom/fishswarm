# FishSwarm environment overrides
#
# Most users can configure providers, workspace, MCP connectors, and skills from
# the app settings UI. Use this file only for local development, CI, or advanced
# runtime overrides.

# API keys
# ANTHROPIC_AUTH_TOKEN=your_anthropic_key
# OPENAI_API_KEY=your_openai_key
# GEMINI_API_KEY=your_gemini_key
# OPENROUTER_API_KEY=your_openrouter_key

# Optional model routing
# CLAUDE_MODEL=anthropic/claude-sonnet-4.5
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Workspace and packaged-resource overrides
# FISHSWARM_WORKDIR=D:/your/workspace
# FISHSWARM_RESOURCES_PATH=D:/myProject/FishSwarm/resources

# MCP / GUI operation runtime overrides
# FISHSWARM_DATA_DIR=D:/FishSwarm/runtime-data
# FISHSWARM_PYTHON_PATH=C:/Python310/python.exe
# FISHSWARM_CLICLICK_PATH=/opt/homebrew/bin/cliclick
# FISHSWARM_DISABLE_IMAGE_TOOL_OUTPUT=1

# Debug logging
# FISHSWARM_LOG_SDK_MESSAGES_FULL=1

# Build-time overrides
# FISHSWARM_BUILD_ROOT=D:/FishSwarm/.build-cache
# FISHSWARM_DOWNLOAD_ALL_NODE_BINARIES=1
# FISHSWARM_PYTHON_MINOR=3.10

# Legacy aliases from earlier FishSwarm builds such as COWORK_* and
# OPEN_COWORK_* are still read for compatibility, but new configuration should
# use the FISHSWARM_* names above.
